{
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "时间轴"
      }
    },
    {
      "path": "pages/record/edit",
      "style": {
        "navigationBarTitleText": "记录此刻"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    }
  ],
  // 分包：主包只放首屏相关页面，其余业务按分包加载，避免主包超过 2MB
  "subPackages": [
    {
      "root": "pagesSub/moment",
      "pages": [
        {
          "path": "detail",
          "style": {
            "navigationBarTitleText": "记录详情"
          }
        }
      ]
    },
    {
      "root": "pagesSub/settings",
      "pages": [
        {
          "path": "index",
          "style": {
            "navigationBarTitleText": "设置"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["pagesSub/moment"]
    }
  },
  "tabBar": {
    "color": "#8a8a8a",
    "selectedColor": "#f2734a",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "时间轴"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "记录生命中的美好时刻",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f7f7f7"
  }
}
